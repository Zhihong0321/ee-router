# Optional PostgreSQL connection string
DATABASE_URL=

# Port for the HTTP server
PORT=3000

# Set production on Railway
NODE_ENV=production

# Optional. Leave blank for open admin routes; set any value to require it as a Bearer token.
ADMIN_API_KEY=
# Optional. A 64-hex value enables AES-256-GCM; blank/invalid values use plaintext storage.
PROVIDER_ENCRYPTION_KEY=

# Comma-separated browser origins, or * for API-only deployments
CORS_ORIGIN=*
# Requests per IP per minute
RATE_LIMIT_MAX=100

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Request log retention in days
REQUEST_LOG_RETENTION_DAYS=30

# Health check interval in milliseconds
HEALTH_CHECK_INTERVAL_MS=30000

# Local Antigravity CLI runtime (production image defaults shown)
AGY_BIN=/usr/local/bin/agy
AGY_SCRATCH_ROOT=/tmp/agyproxy
AGY_DIAGNOSTICS_ROOT=/storage/agy-diagnostics
AGY_TIMEOUT_MS=300000

# Separate random 32+ character key used only for the one-time first OAuth profile import
AGY_PROFILE_IMPORT_KEY=

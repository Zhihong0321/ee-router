# PostgreSQL connection string (Railway auto-provides this)
DATABASE_URL=postgres://user:pass@localhost:5432/eter_router

# Port for the HTTP server
PORT=3000

# Set production on Railway
NODE_ENV=production

# Generate these independently; never commit their real values
ADMIN_API_KEY=replace-with-at-least-32-random-characters
# 32-byte AES key encoded as 64 hexadecimal characters: openssl rand -hex 32
PROVIDER_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Comma-separated browser origins, or * for API-only deployments
CORS_ORIGIN=*
# Requests per IP per minute
RATE_LIMIT_MAX=100

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Request log retention in days
REQUEST_LOG_RETENTION_DAYS=30

# Health check interval in milliseconds
HEALTH_CHECK_INTERVAL_MS=30000
